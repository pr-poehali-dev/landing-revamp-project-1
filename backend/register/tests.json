{
  "tests": [
    {
      "name": "Register new participant",
      "method": "POST",
      "path": "/",
      "body": {"full_name": "Иван Иванов", "phone": "89991234567"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Duplicate phone returns 409",
      "method": "POST",
      "path": "/",
      "body": {"full_name": "Другой Человек", "phone": "89991234567"},
      "expectedStatus": 409,
      "expectedBody": {"error": "duplicate"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid phone returns 400",
      "method": "POST",
      "path": "/",
      "body": {"full_name": "Тест", "phone": "123"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty name returns 400",
      "method": "POST",
      "path": "/",
      "body": {"full_name": "", "phone": "89991234567"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    }
  ]
}
